<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="description" content="Narwal is an open directory of Nix binary caches discovered through Nostr and Blossom.">
<title>Narwal — <%= title %></title>
<style><%= raw(css) %></style>
</head>
<body>
<div class="shell">
  <header class="topbar">
    <a class="wordmark" href="/" aria-label="Narwal home">Narwal<span>.</span></a>
    <nav class="nav" aria-label="Main navigation">
      <a href="/">Directory</a>
    </nav>
  </header>

  <main>
    <%= raw(body) %>
  </main>

  <footer class="bottom-band">
    <span class="bottom-brand">Narwal<span>.</span></span>
    <p>A public index for a more shareable Nix ecosystem.</p>
  </footer>
</div>
</body>
</html>
