<a class="cache-card" href="/cache/<%= hex_to_npub(root.pubkey) %>/<%= channel_path(root.channel) %>">
  <div class="cache-main">
    <div class="cache-name-line"><span class="cache-name"><%= hex_to_npub(root.pubkey) %></span><span class="channel"><%= channel_label(root.channel) %></span></div>
    <%= raw(Enum.map_join(Map.get(root, :nix_sig_keys, []), "\n", &sig_key_template/1)) %>
  </div>
  <div class="metrics" aria-label="Cache index counts">
    <div class="metric-line"><span class="metric-value"><%= pkg_packages(root) %></span><span class="metric-label">packages</span></div>
    <div class="metric-line"><span class="metric-value"><%= pkg_paths(root) %></span><span class="metric-label">paths</span></div>
    <div class="metric-line"><span class="metric-value size-value"><%= pkg_total(root) %></span><span class="metric-label">total</span></div>
  </div>
  <div class="updated"><small>Last update</small><%= relative_time(root.created_at) %></div>
  <span class="open-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h9m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>
